# Render deployment env (copy these names into the Render dashboard; never
# commit real values). See deploy/render/DEPLOY.md for where each value
# comes from. All values are empty here on purpose: the gate checks that
# this file carries names only.
# Turso database URL (libsql://...); secret.
TURSO_DATABASE_URL=
# Turso auth token; secret.
TURSO_AUTH_TOKEN=
# Fernet key for the token store (render_ctl.py gen-key); secret.
TOKEN_ENC_KEY=
# Fyers app id; needed for a Render-side login (live mode only).
FYERS_APP_ID=
# Fyers client id; live mode only, leave unset during the trial.
FYERS_CLIENT_ID=
# Fyers secret id; live mode only, leave unset during the trial.
FYERS_SECRET_ID=
# Fyers PIN; live mode only, leave unset during the trial. Full
# account-login credential: see the warning box in DEPLOY.md.
FYERS_PIN=
# Fyers TOTP secret; live mode only, leave unset during the trial. Full
# account-login credential: see the warning box in DEPLOY.md.
FYERS_TOTP_SECRET=
# Fyers redirect URI (optional).
FYERS_REDIRECT_URI=
# Optional seed for the access token (publish-token normally fills this).
FYERS_ACCESS_TOKEN=
# Mode: live or trial. First deploy uses trial.
RENDER_MODE=
# Always render on the service (non-secret).
PAPER_RUNTIME=
# Sessiond is disabled on Render (the supervisor replaces it).
PAPER_SESSIOND_DISABLE=
# Trial namespace override (trial mode only).
PAPER_NAMESPACE_OVERRIDE=
# 1 to allow a Render-side Fyers login (live mode only); 0 during the trial.
FYERS_AUTO_LOGIN=
# Trial Fyers budget cap per day (may lower, never raise above 1000).
RENDER_TRIAL_DAY_CAP=
