# Render deployment env (copy these into the Render dashboard; never commit
# real values). See deploy/render/DEPLOY.md for where each value comes from.
PAPER_RUNTIME=render
RENDER_MODE=live
PAPER_NAMESPACE_OVERRIDE=
TURSO_DATABASE_URL=libsql://<database>...
TURSO_AUTH_TOKEN=...
TOKEN_ENC_KEY=...
FYERS_AUTO_LOGIN=0
PAPER_SESSIOND_DISABLE=1
